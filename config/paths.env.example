# Template configuration for read-only source genomic data and optional custom panels.
# Copy to config/paths.env (gitignored) and adjust paths for your machine.
# Use WSL paths (/mnt/c/...) for shell scripts executed in WSL2 Ubuntu.

# Strictly read-only directory containing raw WGS files
RAW_DATA_DIR="/mnt/c/path/to/DNA Reports/Raw Data"

# Primary raw VCF filenames inside RAW_DATA_DIR
SNP_INDEL_VCF="sample.snp-indel.genome.vcf"
CNV_VCF="sample.cnv.vcf"
SV_VCF="sample.sv.vcf"

# Optional: custom clinical pathology VCF (GRCh38) for targeted carrier screening
CUSTOM_CLINICAL_VCF=""

# Workspace directories (relative to repo root or absolute WSL paths)
PROCESSED_DIR="data/processed"
ALIGNMENTS_DIR="data/alignments"
REFERENCE_DIR="data/reference"
QC_DIR="results/qc"
REPORTS_DIR="results/reports"
