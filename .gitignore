# ==============================================================================
# Personal Genomics Workspace — Strict Privacy & Data Exclusion Rules
# Never commit genomic data, reference databases, or personal results.
# ==============================================================================

# All data and personal analysis outputs
data/
results/

# Local environment paths (may contain personal directory names)
config/paths.env
config/samples.tsv
.env
.env.*
!.env.example
!config/paths.env.example
!config/samples.tsv.example

# Genomic file formats anywhere in the repository
*.vcf
*.vcf.gz
*.vcf.bgz
*.gvcf
*.gvcf.gz
*.bcf
*.bcf.gz
*.tbi
*.csi
*.idx
*.bam
*.bai
*.cram
*.crai
*.sam
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.fa
*.fa.gz
*.fa.fai
*.fna
*.fna.gz
*.fasta
*.fasta.gz
*.dict
*.bed
*.bed.gz
*.bigWig
*.bw

# Tabular / report outputs that may contain personal variants
*.tsv
*.csv
*.parquet
*.pdf
*.html
*.zip

# Python / uv / OS / Editor artifacts
.venv/
.venv-wsl/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
Thumbs.db

# Claude Code: personal settings and handoff notes (notes can name local paths and runs)
.claude/settings.local.json
.claude/worktrees/
.handoff/

# PharmCAT log (Step 11 now writes it under data/processed/<label>/pharmcat/; this catches older runs)
pharmcat.log
pharmcat.*.log
